# Safe local demo configuration. This never connects to the database configured in .env.
DATABASE_URL=sqlite:///./demo.db
DRY_RUN=true
MIGRATE_ON_START=true
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://127.0.0.1:8000/app
ADMIN_TOKEN=demo-legacy-admin-token
WEBHOOK_SECRET=demo-webhook-secret
TRAINING_WEBHOOK_SECRET=demo-training-webhook-secret
TRAINING_PHONE_ENABLED=false
TRAINING_BROWSER_ENABLED=false
EVALUATOR_PROVIDER=
RECORDING_SOURCE_ENABLED=false
RETENTION_ENFORCEMENT_ENABLED=false

# Cloudinary: paste real non-production credentials, then set RECORDING_STORE=cloudinary.
RECORDING_STORE=
RECORDING_ALLOWED_PROVIDERS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=didm-recordings
