# Copy to .env for local runs. On the host, enter these in the settings screen instead.
# The repository .env loads by default; process variables win. Set DIDM_LOAD_DOTENV=false to opt out.
DIDM_LOAD_DOTENV=true
DRY_RUN=true                 # true = test mode, no real calls or messages
CALLING_START_HOUR=9
CALLING_END_HOUR=21
DAILY_CALL_CAP=100
MAX_PARALLEL_CALLS=1
MAX_ATTEMPTS=3
RETRY_GAP_MINUTES=120
STUCK_CALL_MINUTES=30
TIMEZONE=Asia/Kolkata

ADMIN_TOKEN=
WEBHOOK_SECRET=
PUBLIC_BASE_URL=          # e.g. https://automation.didm.in
DATABASE_URL=
KNOWLEDGE_SARVAM_SYNC_ENABLED=false

SPREADSHEET_ID=
LEADS_SHEET=Leads
GOOGLE_SERVICE_ACCOUNT_JSON=

SARVAM_API_KEY=
SARVAM_MCP_ENCRYPTION_KEY=                 # random 32+ character secret; enables agent metadata auto-fetch
SARVAM_MCP_URL=https://mcp.sarvam.ai/voice-agents
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=

WHATSAPP_ENABLED=true
VEBLIKA_API_KEY=
VEBLIKA_AUTH_NAME=x-api-key  # the key's name, as set in Make's Veblika API key
VEBLIKA_AUTH_IN=header       # header or query, as set in Make's Veblika API key
VEBLIKA_PHONE_NO_ID=
VEBLIKA_TEMPLATE=
VEBLIKA_LANGUAGE=en_US
VEBLIKA_HEADER_IMAGE_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
DAILY_REPORT_HOUR=21
DAILY_REPORT_MINUTE=15

# Webhooks: every delivery is stored first. inline = processed during the request (replies carry the result);
# queued = 200 at once, a background worker processes it. Failed events retry with backoff, then go "dead".
WEBHOOK_PROCESSING=inline
WEBHOOK_WORKERS=4
WEBHOOK_MAX_ATTEMPTS=5
MIGRATE_ON_START=true        # run migrations at start-up; prefer false plus "python -m app.migrate" as a deploy step
TRUST_PROXY_HEADERS=false    # true behind Render's proxy, so rate limits see the real client address

# Training web app (served at /app)
PUBLIC_APP_URL=           # defaults to PUBLIC_BASE_URL + /app
COOKIE_SECURE=true           # false only for local http://localhost
SESSION_TTL_HOURS=72
SESSION_IDLE_HOURS=24
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60
FRONTEND_DIST_DIR=frontend/out

# Training sessions (phase 3). Off until approved: every session is a paid Sarvam call.
TRAINING_PHONE_ENABLED=true
TRAINING_BROWSER_ENABLED=false      # stays false until the Sarvam Web SDK contract is verified live
TRAINING_WEBHOOK_SECRET=
TRAINING_MAX_CONCURRENT_TOTAL=2     # all orgs together; keep within the Sarvam plan minus MAX_PARALLEL_CALLS
TRAINING_DEFAULT_ORG_CONCURRENCY=1
TRAINING_DEFAULT_USER_CONCURRENCY=1
TRAINING_DEFAULT_SESSIONS_PER_DAY=3
TRAINING_DEFAULT_SESSION_MINUTES=10
TRAINING_DEFAULT_MONTHLY_MINUTES=120
TRAINING_START_TIMEOUT_SECONDS=120
TRAINING_END_GRACE_MINUTES=15
# Training intelligence (phase 4): all off until set
TRAINING_PROVIDER_LOOKUPS_ENABLED=false   # read-only Sarvam Analytics: missing transcripts, unknown outcomes
EVALUATOR_PROVIDER=                       # "sarvam" scores transcripts (billed per token); empty = no evaluation
EVALUATOR_MODEL=sarvam-105b
SARVAM_CHAT_API_KEY=
# Phase 5: evaluator cost controls. Every call is metered; organization limits override the monthly defaults
EVALUATOR_TIMEOUT_SECONDS=60
EVALUATOR_MAX_OUTPUT_TOKENS=4096
EVALUATION_MAX_CALLS_PER_SESSION=3        # paid calls per session and rubric version, failures included
EVALUATION_DEFAULT_MONTHLY_CALLS=200
EVALUATION_DEFAULT_MONTHLY_TOKENS=2000000
EVALUATION_PLATFORM_DAILY_CALLS=300       # all organizations together
# Recordings: a private S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). Empty = recordings stay off
RECORDING_STORE=                          # s3 | cloudinary (leave blank until credentials are filled)
RECORDING_ALLOWED_PROVIDERS=              # s3,cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=didm-recordings
S3_ENDPOINT=                              # https://s3.ap-south-1.amazonaws.com or https://<account>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=                                # e.g. ap-south-1, or auto for R2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_SSE=AES256                             # AES256 | aws:kms | none (none only for stores that always encrypt at rest)
S3_KMS_KEY_ID=
S3_PATH_STYLE=true
RECORDING_SOURCE_ENABLED=false            # copy recordings from Sarvam Analytics (needs the Sarvam settings)
# Retention: the daily job reports what is due; it removes nothing but expired recordings until this is true
RETENTION_ENFORCEMENT_ENABLED=false
TRAINING_WEBHOOK_PAYLOAD_DAYS=30          # raw training webhook bodies (transcript, phone) become a summary
BROWSER_TOKEN_RETENTION_DAYS=30
PHONE_CHALLENGE_RETENTION_DAYS=7
# Database pool per process (pool + overflow must stay well under the database's connection limit)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
PHONE_OTP_PROVIDER=                       # reserved: no code sender built in yet, numbers stay admin-confirmed

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=didm-recordings
